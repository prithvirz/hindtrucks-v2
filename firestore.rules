rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /loads/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /drivers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /wallets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /trips/{id} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.driverUid;
      allow create: if request.auth != null;
    }

    match /payouts/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.driverUid;
      allow create: if request.auth != null;
    }
  }
}
