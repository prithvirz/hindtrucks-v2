# ── API Service Mode ──
# Global mode: mock | real | hybrid
# Default: mock (safe — no real API calls)
VITE_API_MODE=mock

# Per-service overrides (only effective when VITE_API_MODE=hybrid)
# Values: mock | real  (unset = mock)
VITE_API_AUTH=
VITE_API_LOADS=
VITE_API_TRIP=
VITE_API_EARNINGS=
VITE_API_PROFILE=
VITE_API_CHAT=

# ── API Infrastructure ──
VITE_API_BASE_URL=/api
VITE_USE_EMULATOR=false

# ── Third-party Keys ──
VITE_ORS_API_KEY=
VITE_FCM_VAPID_KEY=
VITE_API_NOTIFICATIONS=mock
